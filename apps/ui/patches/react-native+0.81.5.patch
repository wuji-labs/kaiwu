+/**
+ * Kaiwu: persists an exception swallowed from an async void TurboModule method (newest last,
+ * capped at 20) to NSUserDefaults key "KaiwuNativeExceptionLog", readable from JS via Settings.
+ */
+static void kaiwuRecordSwallowedNativeException(
+    NSException *exception,
+    const char *moduleName,
+    const std::string &methodName)
+{
+  @try {
+    NSString *module = moduleName ? @(moduleName) : @"?";
+    NSString *method = @(methodName.c_str()) ?: @"?";
+    NSString *name = exception.name ?: @"?";
+    NSString *reason = exception.reason ?: @"";
+    if (reason.length > 500) {
+      reason = [reason substringToIndex:500];
+    }
+    NSArray<NSString *> *symbols = exception.callStackSymbols ?: @[];
+    NSString *stack = [[symbols subarrayWithRange:NSMakeRange(0, MIN((NSUInteger)12, symbols.count))]
+        componentsJoinedByString:@"\n"];
+    NSLog(@"[Kaiwu] swallowed exception in %@.%@: %@ %@", module, method, name, reason);
+    NSDictionary *entry = @{
+      @"atMs" : @((long long)([[NSDate date] timeIntervalSince1970] * 1000)),
+      @"module" : module,
+      @"method" : method,
+      @"name" : name,
+      @"reason" : reason,
+      @"stack" : stack ?: @"",
+    };
+    @synchronized([NSUserDefaults class]) {
+      NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+      NSArray *existing = [defaults arrayForKey:@"KaiwuNativeExceptionLog"] ?: @[];
+      NSMutableArray *next = [existing mutableCopy];
+      [next addObject:entry];
+      while (next.count > 20) {
+        [next removeObjectAtIndex:0];
+      }
+      [defaults setObject:next forKey:@"KaiwuNativeExceptionLog"];
+    }
+  } @catch (__unused NSException *ignored) {
+  }
+}
