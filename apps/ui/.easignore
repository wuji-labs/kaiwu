# `.easignore` overrides `.gitignore`, so keep all generated and local-only
# project state excluded from EAS uploads. Native projects are regenerated by
# EAS Prebuild under the selected build profile.
expo-env.d.ts
app.local.js
/ios/
/android/
modules/*/android/.cxx/
modules/*/android/build/
modules/*/ios/build/
node_modules/
.expo/
dist/
web-build/
public/monaco/
public/vendor/*
!public/vendor/kokoro/
public/vendor/kokoro/*
!public/vendor/kokoro/kokoroTtsWorker.js
public/pierre-diff-worker*.js
.eas/keys/
/src-tauri/permissions/autogenerated/
/src-tauri/target/
/src-tauri/gen/schemas
/src-tauri/binaries/
/src-tauri/systemTasks/
/src-tauri/ssh/
/src-tauri/integrations/
/src-tauri/capabilities/mcp-dev.json

# Local env files should never be uploaded to EAS build workers.
# Use EAS project env vars or `eas.json` `build.<profile>.env` instead.
.env
.env*.local

# local signing credentials are read locally by eas-cli, never uploaded
credentials.json
.eas/keys/
