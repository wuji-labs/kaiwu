{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "无极开物",
  "version": "../package.json",
  "identifier": "com.wujilabs.kaiwu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:dev",
    "beforeBuildCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "default",
        "pet_overlay"
      ],
      "csp": null
    },
    "windows": [
      {
        "title": "无极开物",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#F5F5F5",
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "externalBin": [
      "binaries/hsetup"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "无极开物",
    "publisher": "WUJI-Labs",
    "copyright": "Copyright (c) 2026 Qianyuan Wuji Group (WUJILabs)",
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NDQxNUM4Q0Y5NUQ1NDkKUldSSjFaWFB5QlZFT2NjSGNDRHhMY1NjTVN0ZzNrdCtWN0dDdWtPeFhFVHVCRm9mcXJ1eW5iUUsK",
      "endpoints": [
        "https://kaiwu.wujilabs.cn/download/desktop/latest.json"
      ]
    }
  }
}
